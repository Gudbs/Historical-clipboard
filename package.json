{
  "name": "clip-history",
  "productName": "ClipHistory",
  "version": "1.0.0",
  "description": "Windows 本地剪贴板历史记录工具（全程离线，数据只存本机）",
  "author": "ClipHistory",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.cliphistory",
    "productName": "ClipHistory",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ClipHistory-Setup-${version}.exe"
    },
    "asarUnpack": [
      "build/tray-icon.png"
    ]
  }
}
